# Configuration de l'application allAnime TV.
# Ce fichier est lu au moment du build par app/build.gradle.kts et injecte
# dans BuildConfig. Aucune de ces valeurs ne doit etre codee en dur ailleurs.
#
# La racine du catalogue n'est PLUS ici : elle vient d'Infisical, sous le nom
# BASE_URL_2A. Le build la lit dans cet ordre :
#   1. la variable d'environnement BASE_URL_2A, si elle est definie (CI) ;
#   2. l'API Infisical, via l'identite machine declaree dans local.properties
#      (fichier non versionne : infisical.clientId, infisical.clientSecret,
#      infisical.projectId, infisical.host).
# Elle sert a construire les URLs d'animes :
#   BASE_URL_2A + "/" + slug + "/"   ->   <racine>/classroom-of-the-elite/
#
# La racine du site de lecture, seconde source des saisons et des episodes en plus
# du catalogue, vient d'Infisical de la meme facon, sous le nom BASE_URL_LIS.

# Endpoint GraphQL AniList.
ANILIST_ENDPOINT=https://graphql.anilist.co

# User-Agent du WebView qui affiche les lecteurs (section 19 du cahier des charges).
PLAYER_USER_AGENT=Mozilla/5.0 (Linux; Android 12; BRAVIA 4K GB) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# User-Agent utilise pour le scraping du catalogue (identique a celui des scripts Node de reference).
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)
